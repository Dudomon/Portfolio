{
    "name": "portfolio/legal-doc-analyzer-bedrock",
    "description": "Production-grade legal document analysis platform using AWS Bedrock for public sector applications",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.300",
        "firebase/php-jwt": "^6.10",
        "predis/predis": "^2.2",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "LegalDocAnalyzer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LegalDocAnalyzer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src tests --level=8",
        "cs": "phpcs --standard=PSR12 src tests",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
