{
  "name": "@aigw/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch-based client for the AI gateway (Node and browser).",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aigw/shared": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
