# Base path or absolute URL of the LedgerFlow API (contract: /api/v1).
VITE_API_BASE_URL=/api/v1

# "true" serves the API from MSW handlers in src/mocks, no backend required.
VITE_USE_MOCKS=false

# Where the Vite dev server proxies /api (not exposed to the client bundle).
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
