# Copy to .env for local runs. Values here are for local development only.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://ledgerflow:ledgerflow@localhost:5432/ledgerflow

# HS256 for local use; production uses RS256 with JWT_PRIVATE_KEY plus JWT_PUBLIC_KEY or JWT_JWKS_URL.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900

# Shared with services/worker for the /internal endpoints.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

S3_BUCKET=ledgerflow-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
# Host browsers use to fetch presigned URLs; unset when it equals S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO accepts SSE-S3 only when a KMS key is configured (MINIO_KMS_SECRET_KEY).
S3_SERVER_SIDE_ENCRYPTION=AES256

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.5

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

# Tracing is enabled only when this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
