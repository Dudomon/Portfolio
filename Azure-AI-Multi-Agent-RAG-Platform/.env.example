# Copy to .env for local runs. Leave the *_API_KEY values empty to use Entra ID
# (DefaultAzureCredential: `az login` locally, managed identity in Azure).

AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=gpt-4o
UTILITY_DEPLOYMENT=gpt-4o-mini
JUDGE_DEPLOYMENT=gpt-4o
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
SEARCH_INDEX_NAME=policies-v1
SEMANTIC_CONFIGURATION_NAME=policies-semantic

# Guardrails
REQUEST_TOKEN_BUDGET=24000
REQUEST_TIMEOUT_SECONDS=60
STEP_TIMEOUT_SECONDS=25
MAX_REVISIONS=1

# Telemetry: exported to Azure Monitor only when set.
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO

# Optional JSON override of per-deployment prices (USD per million tokens).
# MODEL_PRICES={"gpt-4o": {"input_per_million": 2.5, "output_per_million": 10.0}}
