APP_ENV=production
APP_DEBUG=false
APP_KEY=your-secret-key-here

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.3

S3_BUCKET_DOCUMENTS=legal-docs-storage
S3_BUCKET_REGION=us-east-1
KMS_KEY_ID=alias/legal-docs-encryption

SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/legal-doc-processing
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/legal-doc-processing-dlq

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

DB_HOST=localhost
DB_PORT=3306
DB_NAME=legal_doc_analyzer
DB_USER=root
DB_PASSWORD=

CLOUDWATCH_LOG_GROUP=/aws/legal-doc-analyzer
CLOUDWATCH_LOG_STREAM=api-logs
XRAY_ENABLED=true

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

OBSERVABILITY_ENABLED=true
METRICS_NAMESPACE=LegalDocAnalyzer
