# Copy to .env for `make run`. Values below match the local docker-compose stack.

LOG_LEVEL=INFO
METRICS_ADDR=:9090
SHUTDOWN_TIMEOUT=30s

AMQP_URL=amqp://guest:guest@localhost:5672/
WORKER_CONCURRENCY=4
WORKER_PREFETCH=8
WORKER_HANDLER_TIMEOUT=5m
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAYS=5s,30s,2m
IDEMPOTENCY_CACHE_SIZE=10000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ledgerflow-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_MAX_OBJECT_BYTES=15728640

# Base URL includes the /api/v1 prefix; the worker appends /internal/...
API_BASE_URL=http://localhost:8000/api/v1
API_SERVICE_TOKEN=change-me
API_TIMEOUT=10s
API_MAX_ATTEMPTS=4

# Any OpenAI-compatible chat completions endpoint that supports json_schema output.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini-2024-07-18
LLM_TIMEOUT=60s
LLM_MAX_ATTEMPTS=3
# Optional price override, USD per 1M tokens: model=input/output,...
# LLM_PRICES=gpt-4o-mini=0.15/0.60,gpt-4o=2.50/10.00
