{
  "name": "@aigw/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible LLM gateway built on NestJS.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
