# Database Configuration
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_PASSWORD=your-mysql-password-here
DATABASE_URL=mysql+pymysql://iptv_user:your-mysql-password-here@localhost:3306/iptv_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production

# Application Settings
FLASK_ENV=production
STREAM_CHECK_INTERVAL=60
WORKERS=4

# Frontend Configuration
REACT_APP_API_URL=http://localhost/api

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS Configuration (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_URL=https://your-cloudfront-url.cloudfront.net

# Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@yourdomain.com
