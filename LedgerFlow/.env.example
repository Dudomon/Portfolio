# Local development only. Copy to .env before `docker compose up`.

POSTGRES_PASSWORD=ledgerflow
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
INTERNAL_SERVICE_TOKEN=change-me-internal-token
SEED_PASSWORD=ledgerflow-demo

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Required by the worker for PDF/image extraction (NF-e XML is parsed without it).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini-2024-07-18
