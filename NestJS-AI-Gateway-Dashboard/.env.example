# Used by docker-compose (gateway service). For local `npm run dev`, copy to
# apps/gateway/.env and adjust DATABASE_URL / REDIS_URL to localhost.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
# Bearer token for /admin and the dashboard login (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Secret mixed into API key hashes; rotating it invalidates every key (>= 32 chars).
API_KEY_PEPPER=

# --- Providers (configure any subset; unconfigured ones are skipped) -------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Enables Bedrock; credentials resolve via the standard AWS chain (AWS_PROFILE, AWS_ACCESS_KEY_ID, IRSA...).
BEDROCK_REGION=

# --- Optional -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed to call the gateway from browsers (SDK in the browser).
CORS_ORIGINS=
# Exact-match cache for temperature-0 requests; 0 disables.
RESPONSE_CACHE_TTL_SECONDS=0
USAGE_FLUSH_INTERVAL_MS=2000
USAGE_FLUSH_BATCH_SIZE=200
USAGE_BUFFER_MAX=10000
API_KEY_CACHE_TTL_MS=30000
# Tracing is enabled only when an OTLP/HTTP endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-gateway
